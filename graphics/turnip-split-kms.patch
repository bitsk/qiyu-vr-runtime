+static void
+wsi_display_log_present_wait(struct wsi_display_swapchain *chain,
+                            const char *stage, VkResult result,
+                            uint64_t requested, uint64_t timeout,
+                            uint64_t start_ns)
+{
+   static uint32_t messages;
+   if (!debug_get_bool_option("TU_A081_PRESENT_WAIT_DEBUG", false) ||
+       p_atomic_inc_return(&messages) > 16)
+      return;
+
+   mtx_lock(&chain->present_id_mutex);
+   uint64_t completed = chain->present_id;
+   VkResult display_error = chain->present_id_error;
+   mtx_unlock(&chain->present_id_mutex);
+   mesa_logw("A081 present wait: stage=%s result=%d requested=%" PRIu64
+             " completed=%" PRIu64 " timeout_ns=%" PRIu64
+             " elapsed_ns=%" PRIu64 " display_error=%d",
+             stage, result, requested, completed, timeout,
+             os_time_get_nano() - start_ns, display_error);
+}
