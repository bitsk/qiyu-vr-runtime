+/* SPDX-License-Identifier: MIT */
+#ifndef TU_A081_DISPLAY_H
+#define TU_A081_DISPLAY_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+/* Explicit A081-only selection of the real, separate mainline KMS device.
+ * Rendering and synchronization remain on the existing MSM render node.
+ */
+static inline int
+tu_a081_display_open(const char *path)
+{
+   char model[256] = {};
+   FILE *file = fopen("/proc/device-tree/model", "r");
+   if (!file) {
+      errno = ENODEV;
+      return -1;
+   }
+   size_t length = fread(model, 1, sizeof(model) - 1, file);
+   fclose(file);
+   if (!length || !strstr(model, "A081") || !path || path[0] != '/') {
+      errno = ENODEV;
+      return -1;
+   }
+
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return -1;
+
+   struct stat st;
+   uint64_t prime = 0;
+   drmVersionPtr version = NULL;
+   drmModeRes *resources = NULL;
+   drmModePlaneRes *planes = NULL;
+   bool connected = false;
+   int saved_errno;
+
+   if (fstat(fd, &st) < 0)
+      goto fail;
+   if (!S_ISCHR(st.st_mode) || drmGetNodeTypeFromFd(fd) != DRM_NODE_PRIMARY) {
+      errno = ENODEV;
+      goto fail;
+   }
+   version = drmGetVersion(fd);
+   if (!version || strcmp(version->name, "msm-kms")) {
+      errno = ENODEV;
+      goto fail;
+   }
+   if (drmGetCap(fd, DRM_CAP_PRIME, &prime) < 0)
+      goto fail;
+   if (!(prime & DRM_PRIME_CAP_IMPORT)) {
+      errno = ENOTSUP;
+      goto fail;
+   }
+   if (drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) < 0 ||
+       drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) < 0)
+      goto fail;
+   /* The session owner must first release KWin's master or supply a real
+    * separately managed display session. Do not seize an occupied device.
+    */
+   if (!drmIsMaster(fd)) {
+      errno = EACCES;
+      goto fail;
+   }
+   resources = drmModeGetResources(fd);
+   if (!resources || !resources->count_crtcs) {
+      errno = ENODEV;
+      goto fail;
+   }
+   for (int i = 0; i < resources->count_connectors; i++) {
+      drmModeConnector *connector = drmModeGetConnector(fd, resources->connectors[i]);
+      if (!connector)
+         continue;
+      if (connector->connection == DRM_MODE_CONNECTED) {
+         for (int m = 0; m < connector->count_modes; m++) {
+            if (connector->modes[m].hdisplay == 1920 &&
+                connector->modes[m].vdisplay == 3664)
+               connected = true;
+         }
+      }
+      drmModeFreeConnector(connector);
+   }
+   planes = drmModeGetPlaneResources(fd);
+   if (!connected || !planes || !planes->count_planes) {
+      errno = ENODEV;
+      goto fail;
+   }
+
+   drmModeFreePlaneResources(planes);
+   drmModeFreeResources(resources);
+   drmFreeVersion(version);
+   return fd;
+
+fail:
+   saved_errno = errno;
+   if (planes)
+      drmModeFreePlaneResources(planes);
+   if (resources)
+      drmModeFreeResources(resources);
+   if (version)
+      drmFreeVersion(version);
+   close(fd);
+   errno = saved_errno;
+   return -1;
+}
+
+static inline bool
+tu_a081_display_matches_fd(int fd, int display_fd)
+{
+   struct stat actual, selected;
+   return fstat(fd, &actual) == 0 && fstat(display_fd, &selected) == 0 &&
+          S_ISCHR(actual.st_mode) && actual.st_rdev == selected.st_rdev;
+}
+
+#endif
